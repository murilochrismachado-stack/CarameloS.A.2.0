# Configurações do Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# Opção A: URL Completa (Usada em hospedagens na nuvem como Aiven/Railway)
# DATABASE_URL="mysql://usuario:senha@host:porta/nome_do_banco"

# Opção B: Banco de Dados MySQL Local
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_PORT=3306
DB_NAME=patas_em_casa_db